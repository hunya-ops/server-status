{
  "name": "server-status",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --ip 127.0.0.1 --port 8787",
    "build": "tsc --noEmit && vite build && node scripts/package-agent.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run && python3 -m unittest discover -s agent/tests",
    "verify": "npm run check && npm test && npm run build && npm run deploy:check",
    "test:integration": "node scripts/integration.mjs",
    "deploy:check": "node scripts/deploy.mjs --dry-run",
    "deploy:ci": "node scripts/deploy.mjs",
    "db:local": "node scripts/database.mjs --local",
    "db:remote": "node scripts/database.mjs --remote",
    "deploy": "node scripts/deploy.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "cloudflare": {
    "bindings": {
      "SETUP_KEY": {
        "description": "Required for first-time setup. Enter a unique random key of at least 32 characters; use it once on the panel to set your password. Keep it private. Do not change it after setup: it also signs sessions."
      }
    }
  }
}
